<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage stats access (user must grant manually in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Package visibility without QUERY_ALL_PACKAGES (a permission Play restricts): every app with a launcher entry
        (labels, icons, the "Ignored apps" list) and the home apps (left out of what is sent). An app with neither is
        invisible: its sessions go out with the package name as their label.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- WorkManager declares its own boot receiver. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Also what lets the foreground watcher start from the background (Android 12+). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- API 33+: asked for from the settings screen only, never at launch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The foreground watcher; it runs only while a feature has asked to watch. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- No backup: the tokens and the device id must not be restored onto another phone. -->
    <application
        android:name=".TimeOrganizerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeOrganizerUsageTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Quick capture's long-press shortcut on the app icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Quick capture's one field (the tile, the shortcut) and the share target ("Save to Inbox"). Exported for the
            share sheet; its own empty task, so it finishes back to the app it was opened over.
        -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/capture_share_label"
            android:icon="@drawable/ic_shortcut_capture"
            android:taskAffinity=""
            android:theme="@style/Theme.TimeOrganizerUsageTracker.Capture"
            android:windowSoftInputMode="stateAlwaysVisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The "Capture" Quick Settings tile; the system binds it. -->
        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_capture"
            android:label="@string/capture_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".review.ReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ignore.IgnoredAppsActivity"
            android:exported="false" />

        <activity
            android:name=".mapping.MappedAppsActivity"
            android:exported="false" />

        <activity
            android:name=".chime.ChimeAppsActivity"
            android:exported="false" />

        <activity
            android:name=".loops.LoopAppsActivity"
            android:exported="false" />

        <!--
            The drift nudge's "Back to it" and "Switch plan": records the answer, opens the home screen or the web planner,
            and finishes unseen. Its own empty task, so it never brings the status screen up with it.
        -->
        <activity
            android:name=".drift.DriftActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            The start ramp's "Start now": starts the block, opens the web app's timer for it, and finishes unseen. Its own
            empty task, like the drift nudge's.
        -->
        <activity
            android:name=".ramp.StartRampActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- specialUse: no other type fits; the subtype is what Play's declaration review reads. -->
        <service
            android:name=".watch.ForegroundWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="While the user has a focus block, a time chime, a loop check, a daily app limit or a break from their desk running, or a block's start notice waiting for a quiet moment, checks every few seconds which app is in front (UsageStatsManager) so the app can nudge them when they drift, a break runs long, they have stayed in a chosen app for another interval, an app reaches the daily limit they set, they keep picking the phone up, or they pick it up after a planned block began. Polls only while the screen is on. Records nothing; stops when the block or break ends, when every daily limit has been reached for the day, or when the user turns the drift nudge, the start ramp, the time chime, the loop check or the daily limits off." />
        </service>

        <!-- The break nudge's buttons; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".breaks.BreakActionReceiver"
            android:exported="false" />

        <!-- The loop check-in's buttons and the away timer's alarm; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".loops.LoopActionReceiver"
            android:exported="false" />

        <!-- The drift nudge's "5 more minutes" and its swipe-away; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".drift.DriftActionReceiver"
            android:exported="false" />

        <!-- The start ramp's "In 2 min", "Not this one", swipe-away and its wake at a block's start; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".ramp.StartRampActionReceiver"
            android:exported="false" />

        <!-- WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
