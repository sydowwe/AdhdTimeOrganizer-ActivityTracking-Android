<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage stats access (user must grant manually in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Package visibility without QUERY_ALL_PACKAGES (a permission Play restricts): every app with a launcher entry
        (labels, icons, the "Ignored apps" list) and the home apps (left out of what is sent). An app with neither is
        invisible: its sessions go out with the package name as their label.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- WorkManager declares its own boot receiver. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Also what lets the foreground watcher start from the background (Android 12+). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- API 33+: asked for from the settings screen only, never at launch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The foreground watcher; it runs only while a feature has asked to watch. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- No backup: the tokens and the device id must not be restored onto another phone. -->
    <application
        android:name=".TimeOrganizerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeOrganizerUsageTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".review.ReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ignore.IgnoredAppsActivity"
            android:exported="false" />

        <activity
            android:name=".mapping.MappedAppsActivity"
            android:exported="false" />

        <!-- specialUse: no other type fits; the subtype is what Play's declaration review reads. -->
        <service
            android:name=".watch.ForegroundWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="While the user has a focus block, a time chime or a break from their desk running, checks every few seconds which app is in front (UsageStatsManager) so the app can nudge them when they drift or a break runs long. Records nothing; stops when the block or break ends." />
        </service>

        <!-- The break nudge's buttons; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".breaks.BreakActionReceiver"
            android:exported="false" />

        <!-- WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
