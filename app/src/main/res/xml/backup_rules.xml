<!-- Android 11 and older. Nothing is backed up: tokens, the device id and the outbox belong to this phone. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
